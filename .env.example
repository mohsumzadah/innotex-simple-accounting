# cp .env.example .env, sonra bütün parolları güclü təsadüfi dəyərlərlə əvəz edin

DB_USERNAME=sade
DB_PASSWORD=change_me_strong_password

# Yeganə istifadəçi: yalnız ilk başlanğıcda (heç bir istifadəçi yoxdursa) yaradılır
ADMIN_EMAIL=admin@innotex.az
ADMIN_PASSWORD=change_me_admin_password

# Tətbiqin veb portu
APP_PORT=8085
